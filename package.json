{
  "name": "pikabo",
  "version": "0.2.0",
  "description": "Automated testing for Chrome extensions \u2014 loads unpacked extensions into a real browser, drives popup/options/content scripts/service worker, and generates reports with screenshots.",
  "keywords": [
    "chrome-extension",
    "testing",
    "automation",
    "playwright",
    "manifest-v3",
    "mcp"
  ],
  "license": "MIT",
  "author": "PixelsTech",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pikabo": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    }
  },
  "files": [
    "dist",
    "src",
    "schema",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --testTimeout=120000",
    "test:all": "vitest run --testTimeout=120000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "docs": "tsx scripts/generate-docs.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^12.1.0",
    "playwright-core": "^1.49.0",
    "yaml": "^2.6.1"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.49.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonic0002/pikabo.git"
  },
  "bugs": {
    "url": "https://github.com/sonic0002/pikabo/issues"
  },
  "homepage": "https://github.com/sonic0002/pikabo#readme"
}
